<%- |
  String  $version,
  String  $mcp_version,
  Integer $port,
  String  $settings_file,
  String  $auth_token,
  String  $allowed_origins,
  String  $allowed_hosts,
| -%>
# Managed by Puppet. Local changes will be overwritten.
name: searxng

services:
  searxng:
    container_name: searxng
    image: docker.io/searxng/searxng:<%= $version %>
    restart: always
    # No ports: reachable only inside the container network at http://searxng:8080.
    volumes:
      - <%= $settings_file %>:/etc/searxng/settings.yml:ro,Z
      - searxng-cache:/var/cache/searxng/
    depends_on:
      - valkey

  valkey:
    container_name: searxng-valkey
    image: docker.io/valkey/valkey:9-alpine
    command: valkey-server --save 30 1 --loglevel warning
    restart: always
    # No ports: reachable only inside the container network.
    volumes:
      - valkey-data:/data/

  mcp-searxng:
    container_name: searxng-mcp
    # Fully qualified: podman (unlike Docker) refuses to pull short names
    # non-interactively ("short-name resolution enforced but cannot prompt
    # without a TTY"), which fails `up -d` under this systemd unit.
    image: docker.io/isokoliuk/mcp-searxng:<%= $mcp_version %>
    restart: always
    stdin_open: false
    environment:
      SEARXNG_URL: http://searxng:8080
      MCP_HTTP_PORT: "3000"
      MCP_HTTP_HOST: 0.0.0.0
      # Hardened static mode: nginx terminates bearer auth for the public
      # websearch vhost, and this token is the second factor nginx forwards.
      MCP_HTTP_HARDEN: "true"
      MCP_HTTP_AUTH_TOKEN: "<%= $auth_token %>"
      MCP_HTTP_ALLOWED_ORIGINS: "<%= $allowed_origins %>"
      # nginx forwards Host unchanged; accept it (plus loopback for local curl).
      MCP_HTTP_ALLOWED_HOSTS: "<%= $allowed_hosts %>"
      # Real client IPs for rate limiting come from the trusted nginx hop.
      MCP_HTTP_TRUST_PROXY: "1"
    # Loopback only: rootful podman opens published ports past firewalld, so binding
    # every interface would expose plain HTTP to the LAN.
    ports:
      - "127.0.0.1:<%= $port %>:3000"
    depends_on:
      - searxng

volumes:
  searxng-cache:
  valkey-data:
