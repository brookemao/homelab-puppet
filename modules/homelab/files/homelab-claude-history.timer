[Unit]
Description=Check human Claude messages during weekday and weekend restriction hours Pacific

[Timer]
OnCalendar=*-*-* 00..08:00/5:00 America/Vancouver
OnCalendar=Mon..Fri *-*-* 09..17:00/5:00 America/Vancouver
OnCalendar=*-*-* 22..23:00/5:00 America/Vancouver
AccuracySec=1s

[Install]
WantedBy=timers.target
