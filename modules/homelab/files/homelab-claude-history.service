[Unit]
Description=Stop iapark's immich-tools devcontainer on overnight Claude use
After=time-sync.target
Wants=time-sync.target
# Repeated history changes must not permanently disable the path watcher.
StartLimitIntervalSec=0
RequiresMountsFor=/home/iapark/.local/share/containers/storage/volumes/claude-home/_data

[Service]
Type=oneshot
User=iapark
Environment=HOME=/home/iapark
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/sbin/homelab-claude-history
TimeoutStartSec=100
