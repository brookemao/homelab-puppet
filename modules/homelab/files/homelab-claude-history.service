[Unit]
Description=Kill iapark's immich-tools devcontainer after overnight human Claude use
After=time-sync.target
Wants=time-sync.target
RequiresMountsFor=/home/iapark/.local/share/containers/storage/volumes/claude-home/_data

[Service]
Type=oneshot
StateDirectory=homelab-claude-history
StateDirectoryMode=0700
# The script runs Podman as iapark to use that user's rootless storage.
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/homelab-claude-history
TimeoutStartSec=240
