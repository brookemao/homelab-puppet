# Managed by Puppet. Local changes will be overwritten.
# Included into the llama-api server block's default location by
# homelab::nginx. Carries no secret (the keys live in the 0600 map file),
# so this file is world-readable. Checking a map variable with `if` is safe
# per the nginx wiki.
if ($llama_api_authorized = 0) {
  return 401;
}
