<%- |
  String $compose_command,
  String $compose_file,
  String $install_dir,
  String $data_dir,
  Optional[String] $encoded_video_location,
  Array[String] $external_libraries,
| -%>
# Managed by Puppet. Local changes will be overwritten.
[Unit]
Description=Immich photo server (podman-compose)
Documentation=https://immich.app
Wants=network-online.target
After=network-online.target
# Wait for all storage mounts, including the optional transcoded-video directory.
RequiresMountsFor=<%= ([$data_dir] + $external_libraries + [$encoded_video_location].filter |$path| { $path != undef }).join(' ') %>

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=<%= $install_dir %>
ExecStart=<%= $compose_command %> -f <%= $compose_file %> up -d --remove-orphans
ExecStop=<%= $compose_command %> -f <%= $compose_file %> down
# First start pulls several GB of images
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
