---
# Copy this file to data/secrets.yaml (ignored by git) and set your Cloudflare token:
#   cp data/secrets.yaml.example data/secrets.yaml
#   chmod 660 data/secrets.yaml
homelab::cloudflare_token: 'your_cloudflare_api_token_here'

# Optional: Immich Postgres password. Defaults to 'immich' if unset.
# Postgres only reads this when it first initialises its data directory
# Adding it offers some extra security in case the port is ever exposed
immich::db_password: 'your_immich_db_password_here'

# SearXNG server secret_key (signs sessions/cookies). Generate one with:
#   openssl rand -hex 32
# The bootstrap script prompts for this (empty input auto-generates) and
# saves it here as `searxng::secret_key`.
searxng::secret_key: 'your_searxng_secret_key_here'

# Bearer token guarding the public SearXNG MCP vhost (websearch.brookemao.ca).
# 32 bytes, hex-encoded. Generate one with:
#   openssl rand -hex 32
# The bootstrap script generates this automatically (or reads
# SEARXNG_AUTH_TOKEN) and saves it here as `searxng::auth_token`. The same
# secret is injected into the MCP container as MCP_HTTP_AUTH_TOKEN and
# pre-registered in llama's --ui-config-file.
searxng::auth_token: 'your_searxng_mcp_bearer_token_here'

# SHA-512 crypt hash of the llama Basic-auth password (user `agentforce`) on
# llama.brookemao.ca. The bootstrap script prompts for the password, hashes it
# with `openssl passwd -6`, and saves only the hash here as
# `llama::basic_auth_password`.
llama::basic_auth_password: 'your_llama_basic_auth_password_hash_here'

# Optional: Cloudflare Tunnel token, from the tunnel's install command in the
# Zero Trust dashboard (Networks > Tunnels).
# Until it is set cloudflared is installed but the tunnel stays stopped.
homelab::cloudflared::tunnel_token: 'your_tunnel_token_here'
